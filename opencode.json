{
  "$schema": "https://opencode.ai/config.json",

  "lsp": true,

  "mcp": {
    "rust-mcp-server": {
      "type": "local",
      "command": ["rust-mcp-server"],
      "enabled": true
    },
    "rust-docs-mcp": {
      "type": "local",
      "command": ["rust-docs-mcp"],
      "transport": "stdio",
      "enabled": true
    },
    "code-graph": {
      "type": "local",
      "command": ["bun", "run", "code-graph"],
      "enabled": true
    }
  },

  "permission": {
    "bash": {
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow"
    },
    "external_directory": {
      "~/.cargo/registry/src/**": "allow",
      "~/.rust-docs-mcp/cache/**": "allow"
    },
    "read": {
      "~/.cargo/registry/src/**": "allow",
      "~/.rust-docs-mcp/cache/**": "allow"
    },
    "edit": {
      "*": "allow",
      "~/.cargo/registry/src/**": "deny",
      "~/.rust-docs-mcp/cache/**": "deny"
    },
    "lsp": "allow"
  }
}
